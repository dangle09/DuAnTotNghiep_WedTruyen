@model IEnumerable<TeenNovel_Wed.Models.GoiNapXu>

@{
    ViewData["Title"] = "Nạp xu";
    Layout = "~/Views/Shared/_LayoutDocGia.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/napxu.css" asp-append-version="true" />
}

<div class="nap-page">

    <div class="page-title">
        <h2>Nạp xu</h2>
        <p>Chọn gói nạp phù hợp với bạn.</p>
    </div>

    <div class="nap-grid">

        @foreach (var item in Model)
        {
            <a asp-action="ChiTietNap" asp-route-id="@item.MaGoiNap" class="nap-card">

                @if (!string.IsNullOrWhiteSpace(item.KhuyenMai))
                {
                    <div class="sale-badge">@item.KhuyenMai</div>
                }

                <div class="nap-name">@item.TenGoi</div>

                <div class="nap-content">
                    <div class="nap-image">
                        @if (!string.IsNullOrEmpty(item.Anh))
                        {
                            <img src="@item.Anh" alt="@item.TenGoi" />
                        }
                        else
                        {
                            <i class="bi bi-coin"></i>
                        }
                    </div>

                    <div class="nap-xu">
                        <span class="xu-number">@item.SoXuNhan.ToString("N0")</span>
                        <span class="xu-text">Xu</span>
                    </div>
                </div>

                <div class="nap-price">@item.SoTien.ToString("N0")đ</div>

            </a>
        }

    </div>

</div>
