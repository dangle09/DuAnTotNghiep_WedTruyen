@model TeenNovel_Wed.Models.Truyen

@{
    ViewData["Title"] = Model.Tentruyen;
    Layout = "~/Views/Shared/_LayoutDocGia.cshtml";
}
@section Styles {

    <link rel="stylesheet" href="~/css/chitiet-truyen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chi-tiet-actions.css" asp-append-version="true" />
}

<!-- BREADCRUMB -->

<div class="ct-breadcrumb">
    <a asp-controller="DocGia"
           asp-action="TrangChu">

        Trang chủ

    </a>
    >

    <a asp-controller="DocGia"
           asp-action="TheLoai"
           asp-route-id="@Model.MaTheLoais">
        @foreach (var tl in Model.MaTheLoais)
        {
            @tl.Tentheloai
        }

    </a>
    >
    <span>

        @Model.Tentruyen

    </span>
</div>

<div class="ct-box">
    <div class="ct-info-wrap">
        <!-- POSTER -->

        <div class="ct-poster">
            <img src="@Model.AnhBia" />
            <div class="rating">

                @{

                    double sao = ViewBag.DiemDanhGia ?? 0;

                    int full = (int)sao;

                }

                @for (int i = 1; i <= 5; i++)
                {

                    if (i <= full)
                    {
                       
                    }
                    else
                    {
                        
                    }

                }


                <br />

                

                <b>
                    
                </b>


            </div>


        </div>

        <!-- THÔNG TIN -->

        <div class="ct-info">


            <h1>

                @Model.Tentruyen

            </h1>
            <hr />
            <p>

                <i class="bi bi-eye"></i>

                Lượt xem:

                <b>
                    @Model.LuotDoc.ToString("N0")
                </b>


            </p>
            <p>

                <i class="bi bi-heart"></i>

                Lượt thích:

                <b>
                    @Model.LuotThich.ToString("N0")
                </b>


            </p>
            <p>

                <b>Tác giả:</b>

                @(Model.MaTacGiaNavigation.TenTacGia ?? "Đang cập nhật")


            </p>
            <p>

                <b>Thể loại:</b>

                <span class="tag">

                    @foreach (var tl in Model.MaTheLoais)
                    {
                        <span class="tag">@tl.Tentheloai</span>
                    }

                </span>


            </p>

            <p>

                <b>Số chương:</b>

                @Model.Chuongs.Count


            </p>

            <p>

                <b>Trạng thái:</b>


                <span class="status">

                    @Model.Trangthai

                </span>


            </p>

            @await Html.PartialAsync("_ChiTietActions")

        </div>


    </div>

    <!-- MÔ TẢ -->
    <div class="ct-description">


        <h2>

            Giới thiệu

        </h2>


        <p>

            @Model.Mota

        </p>
    </div>

    <!-- NÚT ĐỌC -->


    <div class="ct-buttons">

        @if (Model.Chuongs.Any())
        {
            <a class="btn-read"
                   asp-controller="DocGia"
                   asp-action="DocChuong"
                   asp-route-id="@Model.Chuongs.OrderBy(x => x.Thutu).First().Machuong">
                Đọc từ đầu
            </a>
        }
        else
        {
            <button class="btn-read" disabled>
                Chưa có chương
            </button>
        }


        @if (Model.Chuongs.Any())
        {
            <a class="btn-new"
                   asp-controller="DocGia"
                   asp-action="DocChuong"
                   asp-route-id="@ViewBag.ChuongMoi.Machuong">
                Đọc chương mới
            </a>
        }
        else
        {
            <button class="btn-new" disabled>
                Chưa có chương mới
            </button>
        }



    </div>



    <!-- DANH SÁCH CHƯƠNG -->
    <div class="chapter-list">

        @if (Model.Chuongs.Any())
        {
            @foreach (var c in Model.Chuongs.OrderBy(x => x.Thutu))
            {
                @if (c.Giaxu == 0)
                {
                    <a asp-controller="DocGia"
                           asp-action="DocChuong"
                           asp-route-id="@c.Machuong"
                           class="chapter-item">

                        <div class="chapter-name">
                            @c.Tenchuong
                        </div>

                        <div class="chapter-price">
                            
                        </div>

                    </a>
                }
                else
                {
                    <a href="#"
                           class="chapter-item btn-buy-chapter"
                           data-id="@c.Machuong"
                           data-name="@c.Tenchuong"
                           data-price="@c.Giaxu">

                        <div class="chapter-name">
                            @c.Tenchuong
                        </div>

                        <div class="chapter-price">
                            @c.Giaxu Xu
                        </div>

                    </a>
                }
            }
        }
        else
        {
            <div class="chapter-empty">
                <i class="bi bi-journal-x"></i>
                Truyện hiện chưa có chương nào.
            </div>
        }

    </div>

</div>

<div class="buy-modal" id="buyModal">

    <div class="buy-box">

        <h3>Mua chương</h3>

        <p id="buyContent"></p>

        <div class="buy-actions">

            <button type="button"
                    class="buy-cancel"
                    id="btnCancelBuy">
                Hủy
            </button>

            <button type="button"
                    class="buy-confirm"
                    id="btnConfirmBuy">
                Xác nhận
            </button>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/js/chi-tiet-actions.js" asp-append-version="true"></script>

    <script src="~/js/mua-chuong.js" asp-append-version="true"></script>

}