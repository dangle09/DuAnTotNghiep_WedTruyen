@model TeenNovel_Wed.Models.Truyen
@{
    ViewData["Title"] = "ThemTruyen";
    Layout = "~/Views/Shared/_LayoutQuanLy.cshtml";
    ViewData["ActivePage"] = "Truyen";
    ViewData["Breadcrumb"] = "Thêm truyện";
}

@section TopbarAction {
    <a asp-action="QuanLyTruyen" class="ad-topbar-btn ad-topbar-btn--outline">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
}

<div class="ql-form-wrap">
    <form asp-action="ThemTruyen" method="post" enctype="multipart/form-data" id="truyenForm" novalidate>
        @Html.AntiForgeryToken()

        <div class="ql-form-grid">

            <!-- CỘT TRÁI -->
            <div class="ql-form-left">

                <div class="ad-card" style="margin-bottom:16px">
                    <div class="ad-card-head"><span class="ad-card-title">Thông tin cơ bản</span></div>
                    <div class="ad-card-body">

                        <div class="ql-field">
                            <label>Tên truyện <span class="ql-required">*</span></label>
                            <input type="text" name="tentruyen" id="tentruyen"
                                   placeholder="Nhập tên truyện..." maxlength="200" />
                            <span class="ql-field-error" id="err-tentruyen"></span>
                        </div>

                        <div class="ql-field">
                            <label>Tác giả</label>
                            <select name="matacgia" class="ql-select">
                                <option value="">-- Chọn tác giả --</option>
                                @foreach (var tg in (SelectList)ViewBag.DsTacGia)
                                {
                                    <option value="@tg.Value" selected="@tg.Selected">@tg.Text</option>
                                }
                            </select>
                        </div>

                        <div class="ql-field-row">
                            <div class="ql-field">
                                @{
                                    var dsTheLoai = ViewBag.DsTheLoai as List<TeenNovel_Wed.Models.TheLoai>;
                                    var selected = ViewBag.SelectedTheLoai as List<int> ?? new List<int>();
                                }

                                <div class="ql-field">

                                    <label>Thể loại <span class="ql-required">*</span></label>

                                    <div class="category-dropdown">

                                        <button type="button"
                                                id="categoryBtn"
                                                class="category-btn">

                                            <span id="categoryText">
                                                Chọn thể loại
                                            </span>

                                            <i class="bi bi-chevron-down"></i>

                                        </button>

                                        <div class="category-menu" id="categoryMenu">

                                            @foreach (var tl in dsTheLoai)
                                            {
                                                <label class="category-item">

                                                    <input type="checkbox"
                                                           name="matheloai"
                                                           value="@tl.Matheloai"
                                                           class="category-checkbox"
                                                    @(selected.Contains(tl.Matheloai) ? "checked" : null) />

                                                    <span>@tl.Tentheloai</span>

                                                </label>
                                            }

                                        </div>

                                    </div>

                                </div>

                                    <span class="ql-field-error" id="err-matheloai"></span>
                            </div>
                            <div class="ql-field">
                                <label>Trạng thái</label>
                                <select name="trangthai" class="ql-select">
                                    <option value="dangtien">Đang ra</option>
                                    <option value="hoanthanh">Hoàn thành</option>
                                    <option value="tamngung">Tạm ngưng</option>
                                </select>
                            </div>
                        </div>

                        <div class="ql-field">
                            <label>Mô tả</label>
                            <textarea name="mota" rows="5"
                                      placeholder="Tóm tắt nội dung truyện..." maxlength="2000"></textarea>
                            <span class="ql-field-hint">Tối đa 2000 ký tự</span>
                        </div>

                    </div>
                </div>

            </div>

            <!-- CỘT PHẢI -->
            <div class="ql-form-right">

                <div class="ad-card">
                    <div class="ad-card-head"><span class="ad-card-title">Ảnh bìa</span></div>
                    <div class="ad-card-body">
                        <div class="ql-upload-area" id="uploadArea">
                            <img id="previewImg" src="" alt="" style="display:none" />
                            <div id="uploadPlaceholder">
                                <i class="bi bi-image" style="font-size:36px;color:#c4b5fd"></i>
                                <p>Kéo thả hoặc click để chọn ảnh</p>
                                <span>JPG, PNG, WEBP · Tối đa 5MB</span>
                            </div>
                            <input type="file" name="anhbia" id="anhbia"
                                   accept="image/jpeg,image/png,image/webp" />
                        </div>
                        <span class="ql-field-error" id="err-anhbia"></span>
                    </div>
                </div>

            </div>
        </div>

        <!-- NÚT -->
        <div class="ql-form-actions">
            <a asp-action="QuanLyTruyen" class="ad-topbar-btn ad-topbar-btn--outline">Huỷ</a>
            <button type="submit" class="ad-topbar-btn ad-topbar-btn--primary" id="submitBtn">
                <i class="bi bi-plus-lg"></i> Thêm truyện
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <script src="~/js/quan-ly-truyen.js" asp-append-version="true"></script>

    <script>

        initTruyenForm();
        initCategoryDropdown();

    </script>
}
